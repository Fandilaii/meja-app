rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Restaurants ───────────────────────────────────────────
    // Public read (discovery, detail page). Writes require manager role.
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, delete: if request.auth != null
                            && request.auth.token.role == 'manager';
      allow update: if request.auth != null;

      // Tables: public read, any authenticated user can update status
      match /tables/{tableId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // ── Reservations ──────────────────────────────────────────
    // Guests can create without an account (no login required to book).
    // Authenticated managers can read and update (confirm, mark arrived, cancel).
    // Nobody can delete reservations — they must be cancelled instead.
    match /reservations/{reservationId} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    // ── Waitlist ──────────────────────────────────────────────
    // Guests can join without an account.
    // Authenticated managers can read and update entries.
    match /waitlist/{waitlistId} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    // ── Users ─────────────────────────────────────────────────
    // Users can only read and write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
