rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Restaurants ───────────────────────────────────────────
    // Public read (discovery, detail page). Writes require manager role.
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, delete: if request.auth != null
                            && request.auth.token.role == 'manager';
      allow update: if request.auth != null;

      // Tables: public read, any authenticated user can update status
      match /tables/{tableId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // ── Reservations ──────────────────────────────────────────
    // Guests create without auth (no login required to book).
    // Slot-availability queries need public list access (BookingCard, AvailabilityBadge).
    // Guests can read their own reservation by doc ID (confirmation page).
    // Only authenticated managers can update status or query all reservations.
    match /reservations/{reservationId} {
      allow create: if true;
      allow get:    if true;           // single-doc read: confirmation page, no auth needed
      allow list:   if true;           // queries: slot availability checking by guests
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Waitlist ──────────────────────────────────────────────
    // Guests can join without an account.
    // Authenticated managers can read and update entries.
    match /waitlist/{waitlistId} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    // ── Guest Notes ───────────────────────────────────────────
    // Manager-only: notes about guests (allergies, preferences, VIP flags).
    match /guestNotes/{noteId} {
      allow read, write: if request.auth != null;
    }

    // ── Users ─────────────────────────────────────────────────
    // Users can only read and write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
